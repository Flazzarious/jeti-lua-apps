# Always LF in the working tree, on every OS (constitution principle V).
# Overrides Windows core.autocrlf, which would otherwise check files out as CRLF.
* text=auto eol=lf

# PowerShell scripts generated by Spec Kit run fine with LF; keep them consistent.
*.ps1 text eol=lf

# Binary assets: never touch line endings or diff them as text.
*.wav binary
*.mp3 binary
*.png binary
*.jpg binary
*.lc  binary
*.pdf binary
